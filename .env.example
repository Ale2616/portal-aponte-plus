# ===================================================================
# CONFIGURACIÓN DE CONEXIÓN CON WISPHUB (SERVIDOR ÚNICAMENTE)
# NUNCA uses NEXT_PUBLIC_ para llaves secretas ni tokens de WispHub
# ===================================================================

# 1. API REST Oficial de WispHub
WISPHUB_API_KEY=
WISPHUB_BASE_URL=https://api.wisphub.net
WISPHUB_API_URL=https://api.wisphub.net/api

# 2. Credenciales del Panel Web de WispHub (para scraping de Traffic Flow)
WISPHUB_ADMIN_USER=
WISPHUB_ADMIN_PASS=

# 3. Seguridad de Vercel Cron Job (/api/cron/sync-trafico)
CRON_SECRET=

# 4. (Opcional) Vercel KV / Upstash Redis para Caché Distribuido
# Si no se definen, el sistema usa Caché en Memoria L1 + Archivo Local L3 automáticamente
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 5. Integración de Notificaciones Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================================================================
# 6. Integración RouterOS MikroTik (REST API RouterOS v7) - SERVIDOR ÚNICAMENTE
# NUNCA uses NEXT_PUBLIC_ para las credenciales del MikroTik
# ===================================================================
MIKROTIK_HOST="tu_ip_o_dominio_mikrotik" # IP pública o dominio con DDNS
MIKROTIK_PORT="443"                      # Puerto REST (443 / 80) o API (8728 / 8729)
MIKROTIK_USER="usuario_api"              # Usuario con permisos de lectura (read)
MIKROTIK_PASSWORD="password_seguro"
MIKROTIK_USE_SSL="true"

# ===================================================================
# 7. Notificaciones Push Web (Web Push API + VAPID)
# ===================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BFSzM8wajctH6kO4PLnZSWkByuDGcnB-DaDhQH8a5O3GJ9zH5WM5Lcni_KUxalp8f4r5EAWcfx01bQrAe8SSK_E"
VAPID_PRIVATE_KEY="ClQteO3x4scU8Fp1liOK4uiLYdN6-DQNSdGwHeogikY"
VAPID_SUBJECT="mailto:soporte@internetaponteplus.com"

