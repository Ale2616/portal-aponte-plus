# ===================================================================
# CONFIGURACIÓN DE CONEXIÓN CON WISPHUB (SERVIDOR ÚNICAMENTE)
# NUNCA uses NEXT_PUBLIC_ para llaves secretas ni tokens de WispHub
# ===================================================================

# 1. API REST Oficial de WispHub
WISPHUB_API_KEY=
WISPHUB_BASE_URL=https://api.wisphub.net
WISPHUB_API_URL=https://api.wisphub.net/api

# 2. Credenciales del Panel Web de WispHub (para scraping de Traffic Flow)
WISPHUB_ADMIN_USER=
WISPHUB_ADMIN_PASS=

# 3. Seguridad de Vercel Cron Job (/api/cron/sync-trafico)
CRON_SECRET=

# 4. (Opcional) Vercel KV / Upstash Redis para Caché Distribuido
# Si no se definen, el sistema usa Caché en Memoria L1 + Archivo Local L3 automáticamente
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 5. Integración de Notificaciones Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
